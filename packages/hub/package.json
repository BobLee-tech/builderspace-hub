{
  "name": "@kan/hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./access": {
      "types": "./src/access/index.ts",
      "default": "./src/access/index.ts"
    },
    "./accounts": {
      "types": "./src/accounts/index.ts",
      "default": "./src/accounts/index.ts"
    },
    "./archive": {
      "types": "./src/archive/index.ts",
