    },
    "./shared": {
      "types": "./src/shared/index.ts",
      "default": "./src/shared/index.ts"
    },
    "./site": {
      "types": "./src/site/index.ts",
      "default": "./src/site/index.ts"
    },
    "./structure": {
      "types": "./src/structure/index.ts",
      "default": "./src/structure/index.ts"
    },
    "./tasks": {
