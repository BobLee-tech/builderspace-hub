    },
    "./documents/file-import": {
      "types": "./src/documents/file-import.ts",
      "default": "./src/documents/file-import.ts"
    },
    "./permissions": {
      "types": "./src/permissions/index.ts",
      "default": "./src/permissions/index.ts"
    },
    "./github": {
      "types": "./src/github/index.ts",
      "default": "./src/github/index.ts"
    },
    "./public": {
      "types": "./src/public.ts",
      "default": "./src/public.ts"
    },
    "./rate-limit": {
      "types": "./src/rate-limit/index.ts",
      "default": "./src/rate-limit/index.ts"
    },
