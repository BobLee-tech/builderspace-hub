  "license": "AGPL-3.0",
  "scripts": {
    "check-seams": "tsx src/dev/check-seams.ts",
    "check-web-types": "tsx src/dev/check-web-types.ts",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "cli": "pnpm with-env tsx src/cli/main.ts",
    "cli:prod": "dotenv -e ../../.env.production.local -- tsx src/cli/main.ts",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .gitignore",
    "generate": "drizzle-kit generate",
    "lint": "eslint",
    "migrate": "pnpm with-env drizzle-kit migrate",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "@kan/builderspace": "workspace:*",
    "@kan/db": "workspace:*",
    "@kan/logger": "workspace:*",
    "@kan/shared": "workspace:*",
    "better-auth": "^1.4.6",
    "drizzle-orm": "^0.42.0",
    "mammoth": "^1.13.0",
    "pg": "^8.11.3",
    "turndown": "^7.2.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kan/eslint-config": "workspace:*",
    "@kan/prettier-config": "workspace:*",
    "@kan/tsconfig": "workspace:*",
    "@types/node": "^20.17.7",
    "@types/pg": "^8.10.9",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "3.2.4",
    "docx": "^9.12.0",
    "dotenv-cli": "^7.4.4",
    "drizzle-kit": "^0.28.1",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "^3.0.0"
  },
  "prettier": "@kan/prettier-config"
}
